VITE_CLOUDINARY_CLOUD_NAME=tu_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=tu_upload_preset

# El usuario y contraseña del admin YA NO se ponen aquí: se guardan en
# Firestore (colección "admins", contraseña con hash) usando el script
# server/scripts/set-admin-user.js. No hace falta ninguna variable de
# entorno nueva para esto — /api/admin-login.js reutiliza
# FIREBASE_SERVICE_ACCOUNT_KEY (ver más abajo).

# Llave pública VAPID: se usa en el navegador (con prefijo VITE_) para
# suscribirse a las notificaciones push.
VITE_VAPID_PUBLIC_KEY=pega_aqui_tu_llave_publica_vapid

# Llave pública y privada VAPID para el backend (deben ser el MISMO par que
# la llave pública de arriba). Genéralas una sola vez con:
#   npx web-push generate-vapid-keys
# La llave PRIVADA nunca debe subirse a GitHub ni compartirse: solo va como
# variable de entorno en Vercel.
VAPID_PUBLIC_KEY=pega_aqui_tu_llave_publica_vapid
VAPID_PRIVATE_KEY=pega_aqui_tu_llave_privada_vapid
VAPID_SUBJECT=mailto:tucorreo@gmail.com

# Clave secreta que solo tú conoces, para que el cron externo pueda llamar a
# /api/cron-check sin que cualquiera pueda dispararlo. Invéntate una larga y
# aleatoria (ej: usa un generador de contraseñas).
CRON_SECRET=inventa_una_clave_larga_y_secreta

# Contenido COMPLETO (una sola línea) del JSON de la cuenta de servicio de
# Firebase: Firebase Console → ⚙️ Configuración del proyecto → Cuentas de
# servicio → Generar nueva clave privada. Pega todo el JSON aquí como texto.
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
